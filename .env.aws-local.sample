# Values for docker-compose.aws-local.yml. Copy to .env.aws-local (gitignored) and fill in.
#   Copy-Item .env.aws-local.sample .env.aws-local
# Generate random values in PowerShell 7:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(64))   # JWT_SECRET_KEY
#   [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))      # API_KEY, TICKET_QR_SECRET_KEY, passwords

# Postgres (one user owns userdb, stationdb, ticketdb, orderdb, notificationdb, cronjobdb)
POSTGRES_USER=metro
POSTGRES_PASSWORD=
# Host port for psql/pgAdmin access; 5433 avoids clashing with the existing docker-compose.yml
PG_HOST_PORT=5433

# RabbitMQ
RABBITMQ_USER=metro
RABBITMQ_PASSWORD=

# Shared secrets. JWT_SECRET_KEY must be Base64 (all services decode it with Base64).
JWT_SECRET_KEY=
API_KEY=
TICKET_QR_SECRET_KEY=

# MongoDB Atlas M0 SRV string WITHOUT a database path (the database comes from MONGODB_DATABASE).
# REQUIRED for a healthy station-service: with a placeholder URI the app starts, but its
# /actuator/health reports DOWN (Mongo unreachable) and the compose health check fails.
# Your current public IP must be in Atlas Network Access.
# Example: mongodb+srv://metro_station:<password>@metro-m0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=metro-m0
MONGODB_URI=
MONGODB_DATABASE=Bus

# Gateway CORS: comma-separated, no trailing slash
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SMTP for notification-service. REQUIRED for the register flow: register needs an OTP that is
# emailed to the user; with the dummy defaults the send-otp call fails. For a local test without
# SMTP, mark the email as verified directly in Redis (what verify-otp does), valid for 5 minutes:
#   docker compose -f docker-compose.aws-local.yml exec redis redis-cli SET <email> Verified EX 300
# Gmail: use an app password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=


# Optional integrations; leave empty/commented to use the dummy defaults
# OPENAI_API_KEY=
