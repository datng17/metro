# ---------------------------------------------------------------------------
# SSM SecureStrings under <path_prefix>/<ENV_VAR_NAME>.
#
# No secret value is written to Terraform state:
#   - generated: ephemeral random_password -> write-only value_wo.
#     Bump `version` of an entry to generate and write a new value.
#   - placeholder: write-only "dummy" written once. Set the real value with
#     `aws ssm put-parameter --overwrite`; Terraform will not overwrite it.
#   - external: not managed at all (e.g. MONGODB_URI). Only the ARN is built.
# All parameters use the AWS-managed key alias/aws/ssm.
# ---------------------------------------------------------------------------
data "aws_caller_identity" "current" {}

data "aws_region" "current" {}

ephemeral "random_password" "generated" {
  for_each = var.generated_secrets

  length  = each.value.length
  special = false
}

resource "aws_ssm_parameter" "generated" {
  for_each = var.generated_secrets

  name        = "${var.path_prefix}/${each.key}"
  description = "Generated by Terraform (random_password, ${each.value.base64 ? "base64" : "alphanumeric"})"
  type        = "SecureString"
  value_wo = (each.value.base64
    ? base64encode(ephemeral.random_password.generated[each.key].result)
    : ephemeral.random_password.generated[each.key].result
  )
  value_wo_version = each.value.version

  tags = {
    Name       = "${var.path_prefix}/${each.key}"
    SecretKind = "generated"
  }
}

resource "aws_ssm_parameter" "placeholder" {
  for_each = var.placeholder_secrets

  name             = "${var.path_prefix}/${each.key}"
  description      = "Optional key. Placeholder until set with: aws ssm put-parameter --overwrite"
  type             = "SecureString"
  value_wo         = var.placeholder_value
  value_wo_version = 1

  tags = {
    Name       = "${var.path_prefix}/${each.key}"
    SecretKind = "placeholder"
  }
}

locals {
  arn_prefix = "arn:aws:ssm:${data.aws_region.current.region}:${data.aws_caller_identity.current.account_id}:parameter"

  external_arns = { for k in var.external_secrets : k => "${local.arn_prefix}${var.path_prefix}/${k}" }
}
